# Copia a .env o exporta antes de lanzar el backend. Todo es opcional:
# sin variables la app usa los valores por defecto indicados.

# Directorio de datos (DB, workspaces de agentes, uploads, backups)
DATA_DIR=./data

# Ruta de la base de datos SQLite
DB_PATH=./data/app.db

# Workspace raíz de los agentes (dentro de DATA_DIR por defecto)
WORKSPACE_DIR=./data/workspace
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# Límites del sistema
MAX_TOOL_ITERATIONS=8      # iteraciones LLM-herramienta por turno
MAX_TASK_ATTEMPTS=3        # reintentos máximos de una tarea
EXECUTOR_POLL_SECONDS=1.5  # frecuencia del ejecutor

# Clave Fernet para cifrar secretos (se genera sola en data/.secret_key si no existe)
# SECRET_KEY=

# Las claves de proveedores (OpenAI-compatible, etc.) NO van aquí:
# se añaden desde la app (Modelos y conexiones) y se guardan cifradas.
